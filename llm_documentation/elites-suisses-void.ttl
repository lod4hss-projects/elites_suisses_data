@prefix void: <http://rdfs.org/ns/void#>.
@prefix swel: <https://swiss-elites.lod4hss.cloud/resource/>.
@prefix sdh-slc: <https://sdhss.org/ontology/social-life-core/>.

<http://swiss-elites.lod4hss.cloud/void> a void:Dataset ;
    void:uriSpace "https://swiss-elites.lod4hss.cloud/resource/" ;
    void:triples "150000"^^xsd:integer ;
    void:entities "25000"^^xsd:integer ;
    void:classes sdh-slc:C11, crm:E21 ;
    void:properties sdh-short:P9, sdh-slc:P23, sdh-short:P2 ;
    void:sparqlEndpoint <https://swiss-elites.lod4hss.cloud/sparql> ;
    void:exampleResource swel:p12345 .