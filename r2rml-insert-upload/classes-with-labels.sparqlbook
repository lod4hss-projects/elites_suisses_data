  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\n\nselect distinct ?g\nwhere { graph ?g {?s a owl:Class\n  FILTER (CONTAINS(STR(?s), \"_\"))\n  }\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "CONSTRUCT{\n  ?s ?p ?newUri .\n}\nWHERE {\n  { ?s ?p ?oldUri }\n  UNION\n  { ?oldUri ?p ?o }\n  UNION\n  { ?s ?oldUri ?o }\n  FILTER (CONTAINS(STR(?oldUri), \"_\"))\n  BIND (STRBEFORE(STR(?oldUri), \"_\") AS ?newUriStr)\n  BIND (IRI(?newUriStr) AS ?newUri)\n  FILTER (?oldUri != ?newUri)\n}",
    "metadata": {}
  },
  {
    "kind": 1,
    "language": "markdown",
    "value": "## Properties",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\n\nconstruct {?sNew a owl:ObjectProperty}\nwhere { graph ?g {?s a owl:ObjectProperty\n  FILTER (CONTAINS(STR(?s), \"_\"))\n  BIND (STRBEFORE(STR(?s), \"_\") AS ?sNewStr)\n  BIND (IRI(?sNewStr) AS ?sNew)\n  FILTER (?oldUri != ?newUri)\n  }\n}\nlimit 20",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\n\nconstruct {?sNew a owl:DatatypeProperty}\nwhere { graph ?g {?s a owl:DatatypeProperty\n  FILTER (CONTAINS(STR(?s), \"_\"))\n  BIND (STRBEFORE(STR(?s), \"_\") AS ?sNewStr)\n  BIND (IRI(?sNewStr) AS ?sNew)\n  FILTER (?oldUri != ?newUri)\n  }\n}\nlimit 20",
    "metadata": {}
