@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix eso: <http://elites_suisses/ontology/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdh-short: <https://sdhss.org/ontology/shortcuts/>.
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>.
@prefix swel: <https://swiss-elites.lod4hss.cloud/resource/>.

<#identite1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.identite" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://swiss-elites.lod4hss.cloud/resource/p{id}";
        rr:termType rr:IRI;
        rr:class crm:E21;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "name_forename" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P2;
        rr:objectMap [ rr:column "birth_year" ;
                rr:dataType xsd:integer];
    ].
   

<#identifier1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.identifier" ];
    rr:subjectMap [
        rr:template "https://swiss-elites.lod4hss.cloud/resource/p{\"zkf_ID_linked\"}" ;
        rr:termType rr:IRI;
    ];
    rr:predicateObjectMap [
        rr:predicate owl:sameAs;
        rr:objectMap [ rr:column "\"URL\"" ;
                        rr:termType rr:IRI ];
    ]
    .


<#identifier2> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.identifier" ];
    rr:subjectMap [
        rr:column "\"URL\"" ;
        rr:termType rr:IRI 
    ];
        rr:predicateObjectMap [
        rr:predicate eso:identifier_code;
        rr:objectMap [ rr:column "\"Identifier_code\"" ];
    ].



<#education1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.education" ];
    rr:subjectMap [
        rr:template "https://swiss-elites.lod4hss.cloud/resource/p{\"ID_IDENTITE\"}";
        rr:termType rr:IRI;
    ];
    rr:predicateObjectMap [
        rr:predicate eso:has_as_doctoral_advisor;
        rr:objectMap [
            rr:template "https://swiss-elites.lod4hss.cloud/resource/p{\"THÈSE_Directeur_IdIdentité\"}";
            rr:termType rr:IRI;
        ];
    ]
    .


<#entite1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.entites" ];
    rr:subjectMap [
        rr:template "https://swiss-elites.lod4hss.cloud/resource/g{entity_id}";
        rr:termType rr:IRI;
        rr:class crm:E74;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "nom" ];
    ];
    rr:predicateObjectMap [
        rr:predicate eso:entityType;
        rr:objectMap [ rr:column "\"typeEntite\""];
    ].

<#membership1>  a rr:TriplesMap;
    rr:logicalTable [ rr:sqlQuery """
        select m."idIdentite", m.entite_id  
        from elites_suisses.mandat m 
        where m.fonction = 'Membre'
        and m.entite_id > 0
        """ ];
    rr:subjectMap [
        rr:template "https://swiss-elites.lod4hss.cloud/resource/p{\"idIdentite\"}";
        rr:termType rr:IRI;
    ];
    rr:predicateObjectMap [
        rr:predicate eso:memberOf;
        rr:objectMap [  
            rr:template "https://swiss-elites.lod4hss.cloud/resource/g{entite_id}";
            rr:termType rr:IRI; 
        ];
        
    ].