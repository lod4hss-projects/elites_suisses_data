@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix eso: <http://elites_suisses/ontology/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdh-short: <https://sdhss.org/ontology/shortcuts/>.
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>.
@prefix swel: <https://swiss-elites.lod4hss.cloud/resource/>.
@prefix sdh-slc: <https://sdhss.org/ontology/social-life-core/>.

<#identite1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.identite" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://swiss-elites.lod4hss.cloud/resource/p{id}";
        rr:termType rr:IRI;
        rr:class crm:E21;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "name_forename" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-slc:P23;
        rr:objectMap [ rr:template "https://swiss-elites.lod4hss.cloud/resource/gen{fk_gender}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P2;
        rr:objectMap [ rr:column "birth_year" ;
                rr:dataType xsd:integer];
    ].


<#gender1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.gender" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://swiss-elites.lod4hss.cloud/resource/gen{pk_gender}";
        rr:termType rr:IRI;
        rr:class sdh-slc:C11;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "name" ];
    ];
       rr:predicateObjectMap [
        rr:predicate owl:sameAs;
        rr:objectMap [ rr:template "{wikidata_uri}" ];
    ].



<#birth1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.v_person_birth" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://swiss-elites.lod4hss.cloud/resource/{id_birth}";
        rr:termType rr:IRI;
        rr:class crm:E67;
    ];
    rr:predicateObjectMap [
        rr:predicate crm:P98;
        rr:objectMap [ rr:template "https://swiss-elites.lod4hss.cloud/resource/p{child}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate crm:P96;
        rr:objectMap [ rr:template "https://swiss-elites.lod4hss.cloud/resource/p{mother}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate crm:P97;
        rr:objectMap [ rr:template "https://swiss-elites.lod4hss.cloud/resource/p{father}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P1;
        rr:objectMap [ rr:column "birth_year" ;
                rr:dataType xsd:integer];
    ].



<#soc_relation_type1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.social_relationship_type" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://swiss-elites.lod4hss.cloud/resource/srt{pk_social_relationship_type}";
        rr:class sdh-slc:C4;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-short:P9;
        rr:objectMap [ rr:column "name" ];
    ];
    rr:predicateObjectMap [
        rr:predicate owl:sameAs;
        rr:objectMap [ rr:template "{wikidata_uri}"];
    ] .


<#marriage1> a rr:TriplesMap;
    rr:logicalTable [ rr:tableName "elites_suisses.v_mariage" ];
    rr:subjectMap [
        # rr:constant swel: ; does not work,
        # keep the full URI for the template
        rr:template "https://swiss-elites.lod4hss.cloud/resource/mar{id}";
        # rr:termType rr:IRI;
        rr:class sdh-slc:C9;
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-slc:P20;
        rr:objectMap [ rr:template "https://swiss-elites.lod4hss.cloud/resource/p{femme}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-slc:P20;
        rr:objectMap [ rr:template "https://swiss-elites.lod4hss.cloud/resource/p{homme}" ];
    ];
    rr:predicateObjectMap [
        rr:predicate sdh-slc:P16;
        rr:objectMap [ rr:template "https://swiss-elites.lod4hss.cloud/resource/srt{fk_social_relationship_type}" ];
    ].