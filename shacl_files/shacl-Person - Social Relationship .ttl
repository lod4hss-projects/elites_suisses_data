sdh-shacl:sdh-slc_C3_Shape a sh:NodeShape ;
        sh:targetClass sdh-slc:C3 ;
        sh:name "Social Relationship";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];

        sh:property [
            sh:path sdh-short:P1 ;
            sh:name "Standard Date-Time";
            sh:datatype xsd:string;
            sh:order 5;
            ];
    
        sh:property [
            sh:path sdh-slc:P16 ;
            sh:name "has relationship type" ;
            sh:class sdh-slc:C4 ;
            sh:maxCount 1 ;
        ];
    .

sdh-shacl:sdh-slc_C4_Shape a sh:NodeShape ;
        sh:targetClass sdh-slc:C4 ;
        sh:name "Social Relationship Type";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:minCount 1;
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            sh:minCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];
    
    .