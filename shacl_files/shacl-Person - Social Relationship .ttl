@prefix sdh-shacl: <https://sdhss.org/shacl/profiles/>. 
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sdh-short: <https://sdhss.org/ontology/shortcuts/>.
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/>.
@prefix sdh-slc: <https://sdhss.org/ontology/social-life-core/>.

sdh-shacl:sdh-slc_C43_Shape a sh:NodeShape ;
        sh:targetClass sdh-slc:C43 ;
        sh:name "Actor's Role in a Social Relationship";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:minCount 1;
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            sh:minCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];
    
        sh:property [
            sh:path sdh-slc:P73 ;
            sh:name "is social relationship role of" ;
            sh:class crm:E21 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh-slc:P74 ;
            sh:name "is role within" ;
            sh:class sdh-slc:C3 ;
            sh:maxCount 1 ;
        ];
    
        sh:property [
            sh:path sdh-slc:P72 ;
            sh:name "has role quality" ;
            sh:class sdh-slc:C2 ;
            sh:maxCount 1 ;
        ];
    .

sdh-shacl:sdh-slc_C2_Shape a sh:NodeShape ;
        sh:targetClass sdh-slc:C2 ;
        sh:name "Actor's Social Quality";
    
        sh:property [
