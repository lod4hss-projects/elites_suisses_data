            sh:minCount 1;
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            sh:minCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
            sh:order 4;
            ];
    
    .

sdh-shacl:crm_E21_Shape a sh:NodeShape ;
        sh:targetClass crm:E21 ;
        sh:name "Person";
    
        sh:property [
            sh:path sdh-short:P9;
            sh:name "Standard Label";
            sh:datatype xsd:string;
            sh:order 1; 
            sh:minCount 1;
            sh:maxCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P10;
            sh:name "Alternative Label";
            sh:datatype xsd:string;
            sh:order 2;
            ];
    
        sh:property [
            sh:path sdh-short:P11;
            sh:name "Definition";
            sh:datatype xsd:string;
            sh:order 3; 
            sh:minCount 1;
            ];
    
        sh:property [
            sh:path sdh-short:P12;
            sh:name "Additional Note";
            sh:datatype xsd:string;
