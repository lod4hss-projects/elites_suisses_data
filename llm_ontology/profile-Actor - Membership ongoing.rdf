  <owl:ObjectProperty rdf:about="https://sdhss.org/ontology/shortcuts/P1">
    <rdfs:range rdf:resource="https://sdhss.org/ontology/crm-supplement/C39" />
    <rdfs:comment xml:lang="en">This property associates an instance of crm:E2 Temporal Entity with
      an instance of sdh-short:C1 Standard Date-Time, specifying a temporal position within which
      the phenomenon was located.
      It can be seen as a shortcut of the property path : crm:E2 Temporal Entity → crm:P4 has
      time-span →  crm:E52 Time-Span  →  crm:P82 at some time within → crm:E61 Time Primitive but it
      imposes some specific rules regarding the possible values of the time primitive as defined by
      the target class sdh-short:C1 Standard Date-Time.</rdfs:comment>
    <rdfs:label xml:lang="en">at some time within</rdfs:label>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sdh-short:P1</skos:notation>
    <owl:sameAs rdf:resource="https://ontome.net/ontology/p3086" />
    <rdfs:domain rdf:resource="https://sdhss.org/ontology/social-life-core/C5" />
  </owl:ObjectProperty>
