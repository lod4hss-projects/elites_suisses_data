  <owl:ObjectProperty rdf:about="https://sdhss.org/ontology/social-life-core/P3">
    <rdfs:range rdf:resource="https://sdhss.org/ontology/social-life-core/C6" />
    <rdfs:comment xml:lang="en">Associates a membership with the type which defines its identity,
      making clear the kind of membership that is intended (legal, informal, simple association or
      full membership, etc.).
      The type of membership should not be confused with the different roles that a person can take
      on during membership. These can be registered using the sdh-so:P63 has quality during
      membership property or the sdh-so:C13 Social Role Embodiment class.</rdfs:comment>
    <rdfs:label xml:lang="en">has membership type</rdfs:label>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sdh-short:P3</skos:notation>
    <owl:sameAs rdf:resource="https://ontome.net/ontology/p1413" />
