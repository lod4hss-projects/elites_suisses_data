<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xml:base="https://ontome.net/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:swrl="http://www.w3.org/2003/11/swrl#"
  xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <owl:Ontology rdf:about="https://ontome.net/">
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exported from OntoME:
      Profile or Profiles in Project. The ontological consistency is not granted per se and must be
      checked</owl:versionInfo>
    <rdfs:comment xml:lang="en">pr-595: Person Identification ongoing – This profile provides basic
      properties in form of shortcuts to allow the identification of a person</rdfs:comment>
    <rdfs:label xml:lang="en">Profile(s): Person Identification ongoing</rdfs:label>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E21_Person">
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">crm:E21</skos:notation>
    <owl:sameAs rdf:resource="https://ontome.net/ontology/c21" />
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class
      comprises real persons who live or are assumed to have lived. Legendary figures that may have
      existed, such as Ulysses and King Arthur, fall into this class if the documentation refers to
      them as historical figures. In cases where doubt exists as to whether several persons are in
      fact identical, multiple instances can be created and linked to indicate their relationship.
      The CRM does not propose a specific form to support reasoning about possible identity.</rdfs:comment>
    <rdfs:label xml:lang="en">Person</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E62">
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">crm:E62</skos:notation>
    <owl:sameAs rdf:resource="https://ontome.net/ontology/c339" />
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class
      comprises the instances of E59 Primitive Values used for documentation such as free text
      strings, bitmaps, vector graphics, etc. E62 String is not further elaborated upon within the
      model</rdfs:comment>
    <rdfs:label xml:lang="en">String</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://sdhss.org/ontology/crm-supplement/1.0/C39">
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">crm-sup:C39</skos:notation>
    <owl:sameAs rdf:resource="https://ontome.net/ontology/c1888" />
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As a subclass
      of crm:E61 Time Primitive this class comprises strings expressing dates and times. Instances
      of this class should not be identified by IRIs.
      Standard Date-Time strings must follow specific rules.
      The time primitives must be expressed in the form of strings, based on the ISO and XSD format,
      e.g.: '2001-05-23T08:20:00+08:00'.
      The string may contain only a year, e.g. '0851', or a year and a month, e.g. '0851-05', etc.
      It must be built from left to right, and must be complete on the left side, even if truncated
      on the right.
      Years are defined in the Common or Christian Era (CE), they are ordinals starting from the
      first year of the CE, '0001'. There is therefore no zero year. For years before the Common Era
      (BCE) the string must always be prefixed with 'bce', e.g. 'bce0330'.
      Dates are defined in the Julian calendar until Thursday 4 October 1582 and continue in the
      Gregorian calendar from the next day, which was the Friday 15 October 1582. No Gregorian
      proleptic system is allowed before the 15 October 1582 and no Julian calendar dates are
      allowed after this date.
      To express other calendars and ways of definig time it is compulsory to use instances of the
      Temporal Locations class (cf. ???) .</rdfs:comment>
    <rdfs:label xml:lang="en">Standard Date-Time</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://sdhss.org/ontology/shortcuts/P2">
    <rdfs:range rdf:resource="https://sdhss.org/ontology/crm-supplement/1.0/C39" />
    <rdfs:comment xml:lang="en">This property associates a person with his/hers birthdate expressed
      as an instance of sdh-short:C1 Standard Date-Time, specifying a temporal position within which
      the phenomenon of the birth was located.
      It is a shortcut of the property path : crm:E21 Person → (inverse of) crm:P98 brought into
      life→ crm:E67 Birth → crm:P4 has time-span → crm:E52 Time-Span → crm:P81 ongoing throughout →
      crm:E61 Time Primitive but it imposes some specific rules regarding the possible values of the
      time primitive as defined by the target class sdh-short:C1 Standard Date-Time.
      It is an equivalent with the DBpedia dbo:birthDate and Wikidata wdt:P569 Date of Birth
      properties.</rdfs:comment>
    <rdfs:label xml:lang="en">has birth date</rdfs:label>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sdh-short:P2</skos:notation>
    <owl:sameAs rdf:resource="https://ontome.net/ontology/p3087" />
    <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://sdhss.org/ontology/shortcuts/P2">
